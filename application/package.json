{
	"name": "application",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0",
		"npm": ">=9.6.5"
	},
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev --host",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "astro check",
		"lint:fix": "astro check --fix",
		"lint:ci": "astro check --json | tee astro-check-report.txt",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ci": "vitest run --coverage.enabled true --coverage.report=text --coverage.reporter=lcov"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.2.2",
		"gsap": "^3.15.0",
		"lenis": "^1.3.26",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@vitest/coverage-v8": "^4.1.10",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"sharp@0.34.5": true
	}
}
